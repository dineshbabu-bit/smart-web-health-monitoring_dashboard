{
  "name": "smart-web-health-monitoring",
  "version": "1.0.0",
  "description": "Full-Stack Smart Web Application Health Monitoring System (React + Vite & Node.js + Express + Lighthouse)",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "start:backend": "npm start --prefix backend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:backend:all": "npm run test:all --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "test:backend:integration": "npm run test:integration --prefix backend",
    "test:verification": "npm run test:verification --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "check:ports": "node scripts/free-ports.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@google/genai": "^2.32.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.4",
    "@rolldown/binding-darwin-x64": "1.2.4",
    "@rolldown/binding-linux-arm64-gnu": "1.2.4",
    "@rolldown/binding-linux-arm64-musl": "1.2.4",
    "@rolldown/binding-linux-x64-gnu": "1.2.4",
    "@rolldown/binding-linux-x64-musl": "1.2.4",
    "@rolldown/binding-win32-arm64-msvc": "1.2.4",
    "@rolldown/binding-win32-x64-msvc": "1.2.4"
  }
}
