# Smart Web Application Health Monitoring - Backend Configuration
# Port for Express HTTP server (Hosting platforms like Render/Railway inject PORT automatically)
PORT=5000

# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple origins, or * for open access)
# In production, set to your deployed frontend domain (e.g., https://your-app.vercel.app)
CORS_ORIGIN=*

# Google Gemini API configuration for AI Competitor Gap Analyzer
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Lighthouse audit watchdog timeout in milliseconds (default: 180000 = 3 minutes)
LIGHTHOUSE_TIMEOUT_MS=180000

# Custom Chrome executable path (optional, auto-detected or /usr/bin/chromium in Docker)
# CHROME_PATH=/usr/bin/chromium

# Chrome headless flags (comma-separated)
CHROME_FLAGS=--headless=new,--no-sandbox,--disable-gpu,--disable-dev-shm-usage,--ignore-certificate-errors

# Allow auditing local/private IP addresses in production (default: false)
ALLOW_LOCAL_AUDITS=false
